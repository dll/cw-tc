# ---- 密钥与配置（绝不入库）----
.env
.env.*
*.pem
*.key
!deploy/**/*.example

# ---- 上游内容同步产物 ----
data/*
!data/.gitkeep

# ---- 证书（隐私：已签发证书不得入库）----
*.cert.pdf
certs/
certificate-ledger/

# ---- Go ----
packages/server/bin/
packages/server/tmp/
*.exe
*.test
*.out

# ---- 前端：管理端（Vue 3）----
node_modules/
packages/admin/dist/
packages/admin/.vite/
*.local

# ---- 前端：学生端（Flutter / Dart）----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
packages/app/build/
packages/app/.dart_tool/
*.iml

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ---- 本地工具状态（AI 工作记忆，不进仓库）----
.workbuddy/

# ---- 构建/运行产物 ----
releases/
current
backups/
_chrome_profile/
_cp*/
_probe.html
