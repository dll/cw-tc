# ===== 第三课堂 (cw-tc) 环境变量配置 =====
# 该文件服务于 systemd：复制为 /opt/cw-tc/shared/.env 并 chmod 600
# 切勿把真实密钥提交到仓库；本文件仅作模板（.gitignore 已放行 !deploy/**/*.example）。
#
# 命名与做法沿用同系列项目（ccit 的 deploy/.env.example -> /etc/ccit/ccit.env）。
# 安全默认（沿用 ccit）：**任一类凭据未配置 = 该功能 fail-closed 不启用**；
# 例外：加密与签名密钥为**强制项**，缺失则服务拒绝启动（不得退回明文）。

# ===== 服务端 =====
SERVER_PORT=8071
# 监听地址默认 127.0.0.1（仅 nginx 本机反代可达）。
# 切勿改为 0.0.0.0 —— 通配绑定会让公网直连者伪造 XFF 绕过限频。
# CWTC_HOST=127.0.0.1
# CWTC_ADDR=127.0.0.1:8071

# ===== 数据库（PostgreSQL，含 pgvector 扩展）=====
# CWTC_DB_HOST=127.0.0.1
# CWTC_DB_PORT=5432
# CWTC_DB_USER=cwtc
# CWTC_DB_PASSWORD=replace_with_strong_password
# CWTC_DB_NAME=cwtc
# 连接串（如使用则优先于上面的分项）
# CWTC_DB_DSN=postgres://cwtc:password@127.0.0.1:5432/cwtc?sslmode=disable

# ===== 缓存（Redis）=====
# CWTC_REDIS_ADDR=127.0.0.1:6379
# CWTC_REDIS_PASSWORD=
# CWTC_REDIS_DB=0

# ===== 强制密钥（缺失则服务拒绝启动）=====
# 身份证号加密密钥：AES-256-GCM，**必须 32 字节**（base64 或 hex 均可，自行约定）。
# 用于 id_card_cipher 的加解密（仅制证时解密）。轮换需保留旧密钥以解历史数据。
# CWTC_ID_CARD_ENC_KEY=
# 身份证号去重哈希密钥：HMAC-SHA256，**至少 32 字节强随机**。
# 用于 id_card_hash（唯一索引）。**一旦启用不可更换**，否则全部哈希失效。
# CWTC_ID_CARD_HMAC_KEY=
# 会话签名密钥：至少 32 字节强随机；短于 32 字节视为未配置。
# CWTC_SESSION_SECRET=

# ===== 短信（验证码 / 找回 / 通知）=====
# 未配置 = 短信通道关闭（注册与找回不可用）。
# CWTC_SMS_PROVIDER=tencent
# CWTC_SMS_SECRET_ID=
# CWTC_SMS_SECRET_KEY=
# CWTC_SMS_SDK_APP_ID=
# CWTC_SMS_SIGN_NAME=畅网智能科技
# CWTC_SMS_TEMPLATE_CODE=
# --- 防刷（PRD v2 §9.6，缺省值为建议值，可按运营调整）---
# 单手机号日上限
# CWTC_SMS_DAILY_LIMIT_PER_PHONE=10
# 单手机号冷却秒数
# CWTC_SMS_COOLDOWN_SECONDS=60
# 单 IP 每小时上限
# CWTC_SMS_HOURLY_LIMIT_PER_IP=20
# 短信费用日额度（元），超限告警并停发
# CWTC_SMS_DAILY_BUDGET_YUAN=200

# ===== 支付（PRD v2 §7.3；未配置 = 支付功能关闭，仅免费课程可用）=====
# --- 微信支付（Native 扫码 / App）---
# CWTC_WXPAY_MCH_ID=
# CWTC_WXPAY_APP_ID=
# CWTC_WXPAY_API_V3_KEY=
# CWTC_WXPAY_SERIAL_NO=
# CWTC_WXPAY_PRIVATE_KEY_PATH=/opt/cw-tc/shared/wxpay_apiclient_key.pem
# CWTC_WXPAY_NOTIFY_URL=https://cw-tc.ccit-agent.cn/api/v1/pay/wechat/notify
# --- 支付宝（当面付 / App）---
# CWTC_ALIPAY_APP_ID=
# CWTC_ALIPAY_PRIVATE_KEY_PATH=/opt/cw-tc/shared/alipay_app_private_key.pem
# CWTC_ALIPAY_PUBLIC_KEY_PATH=/opt/cw-tc/shared/alipay_public_key.pem
# CWTC_ALIPAY_NOTIFY_URL=https://cw-tc.ccit-agent.cn/api/v1/pay/alipay/notify
# CWTC_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ===== AI 网关（PRD v2 §11.3；未配置 = AI 答疑与知识库重建关闭）=====
# 供应商：面向国内合规模型（避免数据出境）
# CWTC_LLM_PROVIDER=dashscope
# CWTC_LLM_API_KEY=
# CWTC_LLM_BASE_URL=
# CWTC_LLM_MODEL_SMALL=
# CWTC_LLM_MODEL_LARGE=
# Embedding（知识库向量化）
# CWTC_EMBED_PROVIDER=dashscope
# CWTC_EMBED_API_KEY=
# CWTC_EMBED_MODEL=
# 检索参数
# CWTC_RAG_TOP_K=6
# 额度（PRD v2 §16-17；按"学员 × 课程"计）
# CWTC_AI_DAILY_QUOTA_PER_COURSE=20

# ===== 上游内容同步（只读）=====
# 同步脚本的源目录；生产环境若不上传课程资产，可改为相对路径或对象存储拉取。
# CWTC_CONTENT_SOURCE=E:/2026-2027/2026-2027-1/AI化教学创新

# ===== 与 CCIT 官网接入（PRD v2 §7.12）=====
# 公开状态接口开关；关闭则 /api/v1/public/status 返回 404。
# CWTC_PUBLIC_STATUS_ENABLED=true
# 站点自身对外入口（供官网 products[] 引用，仅作展示用）
# CWTC_PUBLIC_ENTRY=https://cw-tc.ccit-agent.cn
# 若官网需要在受保护层展示本产品运营指标，复用 CCIT 既有演进路径：
# 过渡期用共享口令，正式期走 AOC 统一身份（OIDC 授权码 + PKCE）。
# CWTC_ADMIN_TOKEN=

# ===== 部署 =====
DEPLOY_ENV=production
LOG_LEVEL=info
# 日志级别与脱敏：身份证号/手机号必须过滤（§9.2），过滤器默认开启，勿关闭。
# CWTC_LOG_REDACT_SENSITIVE=true
