# cw-tc 生产环境变量模板（腾讯云 / CCIT 既有环境）
# 复制到服务器 /opt/cw-tc/shared/.env 后由运维填入真实值，权限 600。
# 不要将真实值写回仓库；不在本地执行此配置。

SERVER_PORT=8071
CWTC_HOST=127.0.0.1
DEPLOY_ENV=production
LOG_LEVEL=info

# 沿用 CCIT 既有腾讯云 PostgreSQL；不新建数据库。
CWTC_DB_DRIVER=postgres
CWTC_DB_HOST=<existing-ccit-tencent-cloud-postgres-private-host>
CWTC_DB_PORT=5432
CWTC_DB_USER=cw_tc
CWTC_DB_PASSWORD=<server-side-secret>
CWTC_DB_NAME=cw_tc
CWTC_DB_SSLMODE=require
# 可选：由服务器侧安全注入；不要提交真实连接串。
# CWTC_DB_DSN=postgres://...

# 沿用既有腾讯云/CCIT 内网 Redis；不对公网开放。
CWTC_REDIS_ADDR=<existing-ccit-tencent-cloud-redis-private-address>:6379
# CWTC_REDIS_PASSWORD=<server-side-secret>
# CWTC_REDIS_DB=0

# 强制密钥：必须由运维生成并离线备份。
# CWTC_ID_CARD_ENC_KEY=<exactly-32-chars>
# CWTC_ID_CARD_HMAC_KEY=<at-least-32-chars>
# CWTC_SESSION_SECRET=<at-least-32-chars>

CWTC_PUBLIC_STATUS_ENABLED=true
CWTC_LOG_REDACT_SENSITIVE=true
CWTC_PUBLIC_ENTRY=https://cw-tc.ccit-agent.cn
